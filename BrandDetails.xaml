<Page x:Class="LR4__2.Views.BrandDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LR4__2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BrandDetails">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="imgProd" Grid.Column="0" Width="220" Height="220" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,20,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <TextBlock x:Name="tbTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,15,0,0"/>

            <TextBlock x:Name="tbManufacturer" FontSize="16" Margin="0,0,0,8"/>
            <TextBlock x:Name="tbPrice" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="tbDescription" FontSize="14" TextWrapping="Wrap" Margin="0,15,0,0"/>

            <Button Content="Back to list" Width="160" Height="40" Margin="0,30,0,0" HorizontalAlignment="Left" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
