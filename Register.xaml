<Page x:Class="LR4__2.Views.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LR4__2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Register">

    <Grid Background="Gray">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Registration" FontSize="24" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="First name" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="tbFirstName" Height="32" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Last name" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="tbLastName" Height="32" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Login" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="tbLog" Height="32" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Password" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="tbPass" Height="32" Margin="0,0,0,20" Padding="6"/>

            <Button x:Name="btnRegister" Content="Sign up" Height="40" 
                    FontWeight="Bold" Click="btnRegister_Click" Margin="0,0,0,10"/>

            <Button x:Name="btnBackToLogin" Content="Got already an account? Log in!" Height="32" 
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    Click="btnBackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Page>
