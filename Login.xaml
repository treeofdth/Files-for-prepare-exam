<Page x:Class="LR4__2.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LR4__2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid Background="Gray">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Enter the system" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <TextBlock Text="Login" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="tbLog" Height="35" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Password" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="tbPass" Height="35" Margin="0,0,0,25" Padding="8"/>

            <Button Content="Log in" Height="40" FontWeight="Bold"
                    Click="btnLog_Click" Margin="0,0,0,10"/>

            <Button Content="Sign up" Height="35"
                    Click="btnSign_Click" Background="Transparent" 
                    Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>
